#!/usr/bin/env python3
"""propose - queue a proposed change to a host script, for a host Claude session to review.

Run INSIDE a dev container. /host-scripts is read-only there on purpose (these scripts run on the
host as Eli, some under sudo), so a session that wants one changed proposes it instead:

    /host-scripts/propose launch-container.sh
    /host-scripts/propose claude-diagnostics/client/host-diag

That copies the file to /proposed-host-script-updates/<session-name>/<path> for you to edit, keeps
the version you started from beside it as <path>.base (the reviewer three-way merges against it, so
a change landed meanwhile is not undone), and creates <path>.why.md for the reason. Edit the copy,
fill in the reason, then tell Eli the proposal is queued. Running it again on the same file only
prints the paths: it never overwrites a proposal in progress. A path that does not exist yet
proposes a new file.

<session-name> is this Claude Code session's name (its /rename title), found from
$CLAUDE_CODE_SESSION_ID; pass --session NAME when that fails.
"""

from __future__ import annotations

import glob
import json
import os
import re
import shutil
import sys
from pathlib import Path

HOST_SCRIPTS = Path(os.environ.get("HOST_SCRIPTS_DIR") or Path(__file__).resolve().parent)
QUEUE = Path(os.environ.get("HOST_SCRIPT_PROPOSALS_QUEUE", "/proposed-host-script-updates"))
CLAUDE_DIR = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")


def die(msg: str) -> None:
    print(f"propose: {msg}", file=sys.stderr)
    sys.exit(2)


def session_name(sid: str) -> str | None:
    """The session's name: the transcript's last /rename record first, then the status file.

    Same order as gm-assistant's clone-sync-hooks.sh: /rename writes the transcript synchronously,
    while ~/.claude/sessions/<pid>.json is rewritten asynchronously and can lag.
    """
    name = None
    for tp in glob.glob(str(CLAUDE_DIR / "projects" / "*" / f"{sid}.jsonl")):
        with open(tp, errors="replace") as fh:
            for line in fh:
                if "custom-title" not in line:
                    continue
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if r.get("type") == "custom-title" and str(r.get("customTitle") or "").strip():
                    name = r["customTitle"]
    if name:
        return name
    for f in glob.glob(str(CLAUDE_DIR / "sessions" / "*.json")):
        try:
            d = json.load(open(f))
        except (OSError, ValueError):
            continue
        if sid in (d.get("id"), d.get("sessionId"), d.get("session_id")):
            return str(d.get("name") or "").strip() or None
    return None


def kebab(name: str) -> str:
    return re.sub(r"\s+", "-", re.sub(r"[^a-z0-9\s_-]", "", name.lower()).strip())


def main(argv: list[str]) -> None:
    session = None
    if argv[:1] == ["--session"]:
        if len(argv) < 2:
            die("--session needs a NAME")
        session, argv = argv[1], argv[2:]
    if len(argv) != 1 or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0 if argv[:1] in (["-h"], ["--help"]) else 2)
    if not QUEUE.is_dir():
        die(f"no {QUEUE} here. This container predates the proposals queue: ask Eli to relaunch "
            "it with `launch-container --fresh` (or run this inside a dev container, not on the host).")

    rel = Path(argv[0])
    if rel.is_absolute():
        try:
            rel = rel.resolve().relative_to(HOST_SCRIPTS)
        except ValueError:
            die(f"{argv[0]} is not under {HOST_SCRIPTS}; only host scripts can be proposed.")
    if ".." in rel.parts or rel.suffix == ".base" or rel.name.endswith(".why.md"):
        die(f"bad path {rel}: give a path relative to {HOST_SCRIPTS}, e.g. launch-container.sh")
    current = HOST_SCRIPTS / rel
    if current.is_dir():
        die(f"{rel} is a directory; propose the files in it one at a time.")

    if session is None:
        sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
        session = session_name(sid) if sid else None
        if not session:
            die("could not find this session's name (no $CLAUDE_CODE_SESSION_ID, or no record of it "
                "under ~/.claude). Rerun with --session NAME, using the session's /rename title.")
    slug = kebab(session)
    if not slug:
        die(f"session name {session!r} has no usable characters; pass --session NAME")

    dest = QUEUE / slug / rel
    base = dest.with_name(dest.name + ".base")
    why = dest.with_name(dest.name + ".why.md")
    if dest.exists():
        print(f"propose: already queued, edit it in place:\n  {dest}\n  reason: {why}")
        return
    dest.parent.mkdir(parents=True, exist_ok=True)
    if current.exists():
        shutil.copy2(current, dest)
        shutil.copy2(current, base)
    else:
        dest.touch()
        base.touch()
    base.chmod(0o444)
    why.write_text(f"# Proposed change to host-scripts/{rel}\n\nSession: {session}\n\n"
                   "## What it changes and why\n\n(fill in: the problem you hit, and how the change fixes it)\n")
    print(f"propose: queued {rel} for session '{session}'.\n"
          f"  edit:   {dest}\n  reason: {why}\n"
          f"  (leave {base.name} alone: it is the version you started from)\n"
          "Then tell Eli the proposal is queued; a host session reviews it before anything changes.")


if __name__ == "__main__":
    main(sys.argv[1:])
